class_name SnowAudio
extends Node3D
## Layered, state-driven soundscape built from original synthesized assets in
## res://audio (generated by tools/synth_audio.py; no recordings or music).
##
## Board/snow: packed scrape, powder hiss, icy chatter, carve rip and brake skid,
## cross-faded by the SAME surface data the physics uses. Leaving the ground cuts
## every contact layer within ~40 ms; air rush and clothing flutter take over;
## the landing is a layered sub-thump + slap + crunch and the snow resumes.
## Wind: a soft, dark summit bed and a smooth speed rush (no whistles or hiss),
## gentle exposure gusts, and forest shelter via a low-pass on MountainWind.
## Nitro: ignition impact -> resonant build -> sustained "singing ice" core ->
## depletion glide, plus a mechanical sputter when empty.
## Buses: Master (limiter) <- SFX (glue compressor) <- Board / MountainWind /
## Impacts (environment reverb) / Nitro. Music is a separate EMPTY bus.
var rider: SnowRider
var mountain: SnowMountain
var loops: Dictionary = {}          # name -> AudioStreamPlayer
var levels: Dictionary = {}         # name -> smoothed linear level
var streams: Dictionary = {}
var voices: Array[AudioStreamPlayer] = []
var spatial_voices: Array[AudioStreamPlayer3D] = []
var voice_index := 0
var spatial_index := 0
var wind_filter: AudioEffectLowPassFilter
var reverb: AudioEffectReverb
var surface := Vector2.ZERO
var contact := 0.0
var land_boost := 0.0
var exposure := 0.5
var shelter := 0.0
var gust_noise := FastNoiseLite.new()
var clock := 0.0
var whoosh_timer := 0.0
var recent_whooshes: Dictionary = {}
var rng := RandomNumberGenerator.new()

const LOOPS := {
	# name: [bus, gain, smoothing rate (1/s)]
	# Beds are deliberately modest: the soundtrack leads, events punch through.
	"snow_packed": ["Board", 0.24, 30.0], "snow_powder": ["Board", 0.27, 30.0], "snow_ice": ["Board", 0.24, 30.0],
	"carve": ["Board", 0.32, 18.0], "skid": ["Board", 0.45, 14.0],
	"wind_base": ["MountainWind", 0.3, 1.5], "wind_rush": ["MountainWind", 0.27, 3.0],
	"cloth_flutter": ["Board", 0.16, 6.0],
	"nitro_loop": ["Nitro", 0.6, 9.0],
}
const ONE_SHOTS := ["push", "ollie", "land_soft", "land_hard", "land_sketchy", "crash_minor", "crash_moderate",
	"crash_severe", "fatal", "tumble_0", "tumble_1", "tumble_2", "getup", "nitro_ignite", "nitro_deplete",
	"nitro_release", "nitro_empty", "charge_small", "charge_big", "charge_full", "whoosh", "branch_brush"]

func _ready() -> void:
	rng.seed = 3129
	gust_noise.seed = 77
	gust_noise.frequency = 0.05
	gust_noise.fractal_octaves = 2
	setup_buses()
	for name in LOOPS.keys() + ONE_SHOTS:
		streams[name] = load("res://audio/%s.wav" % name)
	for name in LOOPS:
		var p := AudioStreamPlayer.new()
		p.stream = streams[name]
		p.bus = LOOPS[name][0]
		p.volume_db = -80.0
		add_child(p)
		loops[name] = p
		levels[name] = 0.0
	for i in 12:
		var v := AudioStreamPlayer.new()
		v.bus = "Impacts"
		add_child(v)
		voices.append(v)
	for i in 4:
		var s := AudioStreamPlayer3D.new()
		s.bus = "Impacts"
		s.unit_size = 9.0
		s.max_distance = 60.0
		s.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
		s.panning_strength = 1.4
		add_child(s)
		spatial_voices.append(s)
	rider.sound_event.connect(event)
	rider.reset_performed.connect(_on_reset)

func ensure_bus(bus_name: String, send: String) -> int:
	var index := AudioServer.get_bus_index(bus_name)
	if index < 0:
		AudioServer.add_bus()
		index = AudioServer.bus_count - 1
		AudioServer.set_bus_name(index, bus_name)
	AudioServer.set_bus_send(index, send)
	return index

func setup_buses() -> void:
	var master := AudioServer.get_bus_index("Master")
	if AudioServer.get_bus_effect_count(master) == 0:
		var limiter := AudioEffectHardLimiter.new()
		limiter.ceiling_db = -0.8
		AudioServer.add_bus_effect(master, limiter)
	var sfx := ensure_bus("SFX", "Master")
	AudioServer.set_bus_volume_db(sfx, -4.0)
	if AudioServer.get_bus_effect_count(sfx) == 0:
		var glue := AudioEffectCompressor.new()
		glue.threshold = -12.0
		glue.ratio = 2.0
		glue.attack_us = 8000.0
		glue.release_ms = 220.0
		glue.gain = 0.0
		AudioServer.add_bus_effect(sfx, glue)
	var board := ensure_bus("Board", "SFX")
	if AudioServer.get_bus_effect_count(board) == 0:
		var soften := AudioEffectLowPassFilter.new()
		soften.cutoff_hz = 7500.0 # takes the fizz off the snow hiss so it sits under music
		AudioServer.add_bus_effect(board, soften)
	var wind := ensure_bus("MountainWind", "SFX")
	if AudioServer.get_bus_effect_count(wind) == 0:
		wind_filter = AudioEffectLowPassFilter.new()
		wind_filter.cutoff_hz = 5000.0
		AudioServer.add_bus_effect(wind, wind_filter)
	else:
		wind_filter = AudioServer.get_bus_effect(wind, 0)
	var impacts := ensure_bus("Impacts", "SFX")
	if AudioServer.get_bus_effect_count(impacts) == 0:
		reverb = AudioEffectReverb.new()
		reverb.room_size = 0.5
		reverb.damping = 0.6
		reverb.spread = 0.8
		reverb.wet = 0.08
		reverb.dry = 1.0
		reverb.predelay_msec = 40.0
		AudioServer.add_bus_effect(impacts, reverb)
	else:
		reverb = AudioServer.get_bus_effect(impacts, 0)
	ensure_bus("Nitro", "Impacts")
	ensure_bus("Music", "Master") # Reserved for the player's own soundtrack. Never used here.

func play(name: String, volume: float, pitch := 1.0) -> AudioStreamPlayer:
	# Voice stealing: prefer an idle voice, otherwise the oldest in the ring.
	var v: AudioStreamPlayer = null
	for i in voices.size():
		var candidate := voices[(voice_index + i) % voices.size()]
		if not candidate.playing:
			v = candidate
			voice_index = (voice_index + i + 1) % voices.size()
			break
	if v == null:
		v = voices[voice_index]
		voice_index = (voice_index + 1) % voices.size()
	v.stream = streams[name]
	v.bus = "Nitro" if name.begins_with("nitro") or name.begins_with("charge") else "Impacts"
	v.volume_db = linear_to_db(clampf(volume, 0.001, 1.5))
	v.pitch_scale = pitch
	v.play()
	return v

func play_at(name: String, at: Vector3, volume: float, pitch := 1.0) -> void:
	var s := spatial_voices[spatial_index]
	spatial_index = (spatial_index + 1) % spatial_voices.size()
	s.stream = streams[name]
	s.global_position = at
	s.volume_db = linear_to_db(clampf(volume, 0.001, 1.5))
	s.pitch_scale = pitch
	s.play()

func event(kind: String, strength: float) -> void:
	var jitter := rng.randf_range(0.96, 1.04)
	match kind:
		"push": play("push", 0.7)
		"ollie": play("ollie", 0.55 + strength * 0.35, jitter)
		"land":
			land_boost = 1.0
			if strength > 0.45:
				play("land_hard", 0.55 + strength * 0.5, jitter * (1.05 - strength * 0.1))
			else:
				play("land_soft", 0.45 + strength, jitter)
		"land_sketchy":
			land_boost = 1.0
			play("land_sketchy", 0.8, jitter)
			play("land_soft", 0.4 + strength * 0.4, jitter)
		"crash":
			stop_board()
			play(["crash_minor", "crash_moderate", "crash_severe"][mini(rider.crash_tier(), 2)], 0.9, jitter)
		"fatal":
			stop_board()
			play("fatal", 1.0)
		"tumble": play("tumble_%d" % rng.randi_range(0, 2), 0.25 + strength * 0.6, rng.randf_range(0.85, 1.15))
		"getup": play("getup", 0.6)
		"charge": play("charge_big" if strength > 0.45 else "charge_small", 0.45 + strength * 0.4)
		"full": play("charge_full", 0.7)
		"boost": play("nitro_ignite", 1.0)
		"deplete": play("nitro_deplete", 0.9)
		"boost_release": play("nitro_release", 0.6)
		"empty": play("nitro_empty", 1.0)
		"bough": play_at("branch_brush", rider.global_position + Vector3.UP * 1.5, 0.5 + strength * 0.4, jitter)

func stop_board() -> void:
	for name in ["snow_packed", "snow_powder", "snow_ice", "carve", "skid", "nitro_loop"]:
		levels[name] = 0.0
		loops[name].volume_db = -80.0

func _on_reset() -> void:
	stop_board()
	for v in voices:
		v.stop()
	land_boost = 0.0

func target_levels() -> Dictionary:
	var t := {}
	var speed := rider.speed
	var r := clampf(speed / 38.0, 0.0, 1.4)
	var running := rider.run.state == "running" or rider.run.state == "finished"
	var packed := clampf(1.0 - surface.x - surface.y, 0.0, 1.0)
	var c := contact * (1.0 + land_boost * 0.5)
	var drive := pow(r, 0.7)
	t["snow_packed"] = c * drive * packed
	t["snow_powder"] = c * drive * surface.x
	t["snow_ice"] = c * r * surface.y
	t["carve"] = c * absf(rider.steer) * smoothstep(0.08, 0.55, r)
	var slide := maxf(rider.brake_input * minf(1.0, speed / 5.0), clampf(absf(rider.lateral_slip) / 12.0, 0.0, 1.0))
	t["skid"] = c * slide
	var air := 1.0 if rider.airborne and running else 0.0
	# Wind: a soft breathing bed plus a dark rush that only builds at real speed.
	var gust := 1.0 + 0.18 * gust_noise.get_noise_1d(clock) * (0.5 + exposure)
	t["wind_base"] = (0.35 + 0.4 * exposure) * gust * (1.0 - shelter * 0.5)
	t["wind_rush"] = (r * r + air * 0.2 * r) * (1.0 - shelter * 0.35)
	t["cloth_flutter"] = air * r + smoothstep(0.85, 1.3, r) * 0.5
	t["nitro_loop"] = 1.0 if rider.boosting else 0.0
	return t

func _physics_process(delta: float) -> void:
	clock += delta
	global_position = rider.global_position
	var running := rider.run.state == "running" or rider.run.state == "finished"
	var grounded := rider.ground_contact and rider.recovery <= 0.0 and running
	# Contact: fast release when the board leaves the snow, instant re-engage on landing.
	contact = 1.0 if grounded else maxf(0.0, contact - delta / 0.04)
	land_boost = maxf(0.0, land_boost - delta / 0.35)
	surface = surface.lerp(rider.surface, 1.0 - exp(-4.0 * delta))
	update_environment(delta)
	var targets := target_levels()
	for name in LOOPS:
		var rate: float = LOOPS[name][2]
		if name in ["snow_packed", "snow_powder", "snow_ice", "carve", "skid"] and not grounded:
			rate = 60.0
		if name == "nitro_loop" and not rider.boosting:
			rate = 4.0
		levels[name] = lerpf(levels[name], targets[name], 1.0 - exp(-rate * delta))
		var p: AudioStreamPlayer = loops[name]
		var level: float = levels[name] * LOOPS[name][1]
		if level > 0.002:
			if not p.playing:
				p.play(rng.randf() * p.stream.get_length())
			p.volume_db = linear_to_db(level)
		elif p.playing:
			p.stop()
	var r := clampf(rider.speed / 38.0, 0.0, 1.4)
	loops["snow_packed"].pitch_scale = 0.8 + r * 0.45
	loops["snow_powder"].pitch_scale = 0.85 + r * 0.3
	loops["snow_ice"].pitch_scale = 0.85 + r * 0.55
	loops["carve"].pitch_scale = 0.8 + r * 0.4
	loops["skid"].pitch_scale = 0.9 + r * 0.25
	loops["wind_rush"].pitch_scale = 0.85 + r * 0.25
	loops["cloth_flutter"].pitch_scale = 0.8 + r * 0.5
	loops["nitro_loop"].pitch_scale = 0.92 + clampf(rider.boost_time, 0.0, 2.0) * 0.06 + r * 0.08
	update_passbys(delta)

## Exposure from local convexity/elevation; forest shelter muffles wind and
## shortens reverb; gorges and cliff bands open up an echo on impacts/nitro.
func update_environment(delta: float) -> void:
	var p := rider.global_position
	var z := p.z / SnowMountain.DISTANCE_SCALE
	var forest := SnowMountain.band(z, 2800, 4700, 250)
	var h := SnowMountain.height_at(p.x, p.z)
	var around := 0.25 * (SnowMountain.height_at(p.x - 40, p.z) + SnowMountain.height_at(p.x + 40, p.z) + SnowMountain.height_at(p.x, p.z - 40) + SnowMountain.height_at(p.x, p.z + 40))
	var convex := clampf((h - around) / 6.0, -1.0, 1.0)
	var altitude := clampf((h - 1200.0) / 2000.0, 0.0, 1.0)
	var target_exposure := clampf(0.45 + convex * 0.35 + altitude * 0.3 - forest * 0.4, 0.0, 1.0)
	exposure = lerpf(exposure, target_exposure, 1.0 - exp(-1.2 * delta))
	shelter = lerpf(shelter, forest, 1.0 - exp(-1.0 * delta))
	if wind_filter:
		wind_filter.cutoff_hz = lerpf(5000.0, 1600.0, shelter)
	var enclosed := clampf(-convex, 0.0, 1.0)
	var cliffs := SnowMountain.band(z, 1100, 2800, 200) + SnowMountain.band(z, 4700, 6500, 200) * 0.6
	if reverb:
		reverb.wet = lerpf(reverb.wet, 0.05 + enclosed * 0.12 + cliffs * 0.08 - forest * 0.03, 1.0 - exp(-1.0 * delta))
		reverb.room_size = lerpf(reverb.room_size, 0.45 + cliffs * 0.35 - forest * 0.15, 1.0 - exp(-1.0 * delta))
		reverb.damping = lerpf(reverb.damping, 0.5 + forest * 0.4, 1.0 - exp(-1.0 * delta))

## Trunks and boulders flashing past at speed: a positional whoosh at the hazard.
func update_passbys(delta: float) -> void:
	whoosh_timer -= delta
	if whoosh_timer > 0.0 or mountain == null or rider.speed < 12.0 or rider.recovery > 0.0:
		return
	whoosh_timer = 0.08
	var p := rider.global_position
	var fwd := Vector3(rider.velocity.x, 0, rider.velocity.z).normalized()
	for key in recent_whooshes.keys():
		if clock - recent_whooshes[key] > 3.0:
			recent_whooshes.erase(key)
	for h in mountain.hazards_near(p, 8.0):
		var to := Vector3(h.x - p.x, 0, h.z - p.z)
		var ahead := to.dot(fwd)
		var lateral := (to - fwd * ahead).length() - h.w
		if ahead < 0.0 or ahead > rider.speed * 0.25 or lateral > 6.0 or lateral < 0.2:
			continue
		var key := Vector3i(int(h.x * 4.0), 0, int(h.z * 4.0))
		if recent_whooshes.has(key):
			continue
		recent_whooshes[key] = clock
		var strength := clampf(rider.speed / 35.0, 0.3, 1.2) * clampf(1.3 - lateral / 6.0, 0.3, 1.0)
		play_at("whoosh", Vector3(h.x, p.y + 1.0, h.z), strength, clampf(0.85 + rider.speed / 70.0, 0.85, 1.5))
		break

func _exit_tree() -> void:
	for child in get_children():
		if child is AudioStreamPlayer or child is AudioStreamPlayer3D:
			child.stop()
			child.stream = null
	streams.clear()
